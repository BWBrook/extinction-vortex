#!/bin/bash
#PBS -N vortex_s1a
#PBS -q normal
#PBS -l select=1:ncpus=8:mem=5gb
# Stage 1a sampling pilot: JOBCPUS single-threaded workers per job, each running its LPT-assigned settings.
# Small jobs backfill into partly occupied nodes (a whole 28-core node waited 21 h for the smoke on 15-16 Oct 2026).
# qsub -l select=1:ncpus=C:mem=M -l walltime=HH:MM:SS -v VBASE=...,SETTINGS=...,OUTDIR=...,JOB=j,JOBCPUS=C,NW=n,WALL_SECS=s s1a_node.pbs
# Workers stop starting batches 10 minutes before the walltime and write explicit censored checkpoints.
set -o pipefail
source "$VBASE/src/analysis/fable/calibration/kunanyi/env.sh"
S="$VBASE/s1a"; mkdir -p "$S/$OUTDIR/logs"
DEADLINE=$(( $(date +%s) + WALL_SECS - 600 ))
pids=()
for i in $(seq 0 $(( JOBCPUS - 1 ))); do
  w=$(( JOB * JOBCPUS + i ))
  python -I analysis/fable/calibration/v2_dev/p2_stage1a.py run "$S/$SETTINGS" "$S/p2_metric.json" "$S/$OUTDIR" \
    "$w" "$NW" "$DEADLINE" > "$S/$OUTDIR/logs/w$w.log" 2>&1 &
  pids+=($!)
done
fail=0
for p in "${pids[@]}"; do wait "$p" || fail=$((fail + 1)); done
echo "job $JOB host $(hostname) workers failed: $fail" >> "$S/$OUTDIR/logs/jobs.log"
exit "$fail"
