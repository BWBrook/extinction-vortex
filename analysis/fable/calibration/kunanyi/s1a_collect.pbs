#!/bin/bash
#PBS -N vortex_s1a_collect
#PBS -q normal
#PBS -l select=1:ncpus=1:mem=8gb
#PBS -l walltime=01:00:00
#PBS -M barry.brook@utas.edu.au
#PBS -m ae
# Runs after every Stage 1a job (afterany): collects and packs the outputs with a checksum, then emails Barry.
# qsub -v VBASE=...,SETTINGS=...,OUTDIR=... -W depend=afterany:ID:ID... s1a_collect.pbs
set -o pipefail
source "$VBASE/src/analysis/fable/calibration/kunanyi/env.sh"
S="$VBASE/s1a"; rc=0
python -I analysis/fable/calibration/v2_dev/p2_stage1a.py collect "$S/$SETTINGS" "$S/p2_metric.json" "$S/$OUTDIR" \
  "$S/$OUTDIR/collect.json" > "$S/$OUTDIR/collect.log" 2>&1 || rc=$?
# Pack, then verify the archive against the files (tar -d); retry once the shared filesystem settles. The smoke's
# first pack reported "file changed as we read it" seconds after the node job ended; a later repack verified cleanly.
pack() { tar -czf "$OUTDIR.tar.gz" --exclude="$OUTDIR/logs/collect.out" --exclude="$OUTDIR/logs/collect.err" \
  "$OUTDIR" "$SETTINGS" p2_metric.json && tar -dzf "$OUTDIR.tar.gz" > /dev/null; }
cd "$S" && { pack || { sleep 60; pack; } || { sleep 300; pack; }; } && sha256sum "$OUTDIR.tar.gz" > "$OUTDIR.tar.gz.sha256" || rc=${rc/#0/4}
exit "$rc"
