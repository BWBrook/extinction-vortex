#!/bin/bash
#PBS -N s1b_collect
#PBS -q normal
#PBS -l select=1:ncpus=1:mem=16gb
#PBS -l walltime=08:00:00
#PBS -M barry.brook@utas.edu.au
#PBS -m ae
# Runs after a Stage 1b wave's job array (afterany): validates every shard of the wave, assembles libraries, accounts
# CPU, then packs the wave's libraries and summary as TAG.tar.gz (TAG is the wave, or wave_label for a topup array) with
# a verified checksum, and emails Barry. Summary, log and pack list are collect_TAG.json, collect_TAG.log and
# pack_TAG.txt, so collectors of one wave's arrays share no files. A collection taken while another array of the wave
# still runs is a snapshot; only one taken after every array of the wave has ended is authoritative.
set -o pipefail
source "$VBASE/src/analysis/fable/calibration/kunanyi/env.sh"
S="$VBASE/s1b"; RUN="$S/$OUTDIR"; rc=0
python -I analysis/fable/calibration/v2_dev/p3_stage1b.py collect "$S/$SETTINGS" "$S/p3_metric.json" "$RUN" "$WAVE" \
  "$RUN/collect_$TAG.json" > "$RUN/collect_$TAG.log" 2>&1 || rc=$?
pack() { tar -czf "$TAG.tar.gz" -C "$RUN" -T "$RUN/pack_$TAG.txt" && tar -dzf "$TAG.tar.gz" -C "$RUN" > /dev/null; }
cd "$RUN" && { pack || { sleep 60; pack; } || { sleep 300; pack; }; } && sha256sum "$TAG.tar.gz" > "$TAG.tar.gz.sha256" || rc=${rc/#0/4}
exit "$rc"
