#!/bin/bash
#PBS -N vortex_setup
#PBS -q normal
#PBS -l select=1:ncpus=4:mem=64gb
#PBS -l walltime=02:00:00
# Install nlme 3.1-171 into the project R library (once) and run preflight for the manifest.
# qsub -v VBASE=/u/bwbrook/vortex/run1 setup.pbs
set -eo pipefail
source "$VBASE/src/analysis/fable/calibration/kunanyi/env.sh"
mkdir -p "$VBASE/Rlib"
if ! Rscript -e 'quit(status = as.integer(packageVersion("nlme") != "3.1.171"))'; then
  Rscript -e 'for (u in c("https://cloud.r-project.org/src/contrib/Archive/nlme/nlme_3.1-171.tar.gz",
                          "https://cloud.r-project.org/src/contrib/nlme_3.1-171.tar.gz"))
                if (!inherits(try(install.packages(u, repos = NULL, type = "source",
                                                   lib = Sys.getenv("R_LIBS_USER"))), "try-error") &&
                    packageVersion("nlme", lib.loc = Sys.getenv("R_LIBS_USER")) == "3.1.171") break'
fi
Rscript -e 'stopifnot(packageVersion("nlme") == "3.1.171"); cat(R.version.string, "nlme", as.character(packageVersion("nlme")), "\n")'

python analysis/fable/calibration/preflight.py "$VBASE/validation_manifest.json" "$VBASE" "$VBASE/src"
